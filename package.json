{
  "name": "aeUltraSlim",
  "version": "2.0.0",
  "keywords": [
    "util",
    "functional",
    "server",
    "client",
    "browser"
  ],
  "type": "module",
  "scripts": {
    "docs": "jsdoc --configure jsdoc-conf.json",
    "test": "jasmine-browser-runner runSpecs",
