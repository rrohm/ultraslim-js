  },
  "author": "Robert Rohm&lt;r.rohm@aeonium-systems.de&gt;",
  "contributors": [],
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "jasmine": "^7.0.0",
    "jasmine-ajax": "^4.0.0",
    "jasmine-browser-runner": "^5.0.0",
    "jsdoc": "^4.0.5",
    "jshint": "^2.13.6",
    "terser": "^5.51.2"
  }
}
